# Copy this file to ".env", then fill one or more API-key fields.
#
# Multiple keys for one provider:
#   PROVIDER_API_KEYS=first_key,second_key,third_key
#
# Disable a provider in any of three ways:
#   1. Set PROVIDER_ENABLED=false
#   2. Remove its name from LLM_PROVIDER_ORDER
#   3. Leave its API key blank
#
# Model IDs change over time. The values below are working examples from
# provider documentation as of 2026-08-01; replace them with models enabled
# for your own account/free tier.

# ----------------------------- Router behavior -----------------------------

# priority:
#   Always prefer the first healthy candidate in LLM_PROVIDER_ORDER.
# round_robin:
#   Rotate the starting candidate after each successful request.
ROUTER_MODE=priority

LLM_PROVIDER_ORDER=google,groq,mistral,openrouter,cloudflare,cohere,nvidia,huggingface,sambanova,fireworks

# A failed key/provider is temporarily skipped for this many seconds.
ROUTER_COOLDOWN_SECONDS=300

# Per-request network timeout.
ROUTER_TIMEOUT_SECONDS=60

# 0 means try every eligible candidate. A positive number caps attempts/call.
ROUTER_MAX_ATTEMPTS=0

# Maximum provider error text retained in exceptions/logs.
ROUTER_MAX_ERROR_BODY_CHARS=600

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
ROUTER_LOG_LEVEL=WARNING


# ------------------------ Google AI Studio / Gemini ------------------------

GOOGLE_ENABLED=true
GOOGLE_API_KEYS=
GOOGLE_MODEL=gemini-3.5-flash
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai


# ---------------------------------- Groq -----------------------------------

GROQ_ENABLED=true
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1


# -------------------------------- Mistral ----------------------------------

MISTRAL_ENABLED=true
MISTRAL_API_KEYS=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1


# ------------------------------- OpenRouter --------------------------------

OPENROUTER_ENABLED=true
OPENROUTER_API_KEYS=

# Automatically chooses from currently available free models.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=LLM Key Router


# -------------------------- Cloudflare Workers AI --------------------------

CLOUDFLARE_ENABLED=true
CLOUDFLARE_API_KEYS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b

# Keep {account_id}; the router substitutes CLOUDFLARE_ACCOUNT_ID.
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1


# --------------------------------- Cohere ----------------------------------

COHERE_ENABLED=true
COHERE_API_KEYS=
COHERE_MODEL=command-a-plus-05-2026
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1


# ------------------------------- NVIDIA NIM --------------------------------

NVIDIA_ENABLED=true
NVIDIA_API_KEYS=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1


# ---------------------- Hugging Face Inference Providers -------------------

HUGGINGFACE_ENABLED=true
HUGGINGFACE_API_KEYS=

# ":fastest" lets Hugging Face select the fastest provider currently serving it.
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1


# ------------------------------ SambaNova Cloud ----------------------------

SAMBANOVA_ENABLED=true
SAMBANOVA_API_KEYS=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1


# -------------------------------- Fireworks --------------------------------

FIREWORKS_ENABLED=true
FIREWORKS_API_KEYS=

# Example DeepSeek-family model through Fireworks. Change if not available
# to your account or initial credit.
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v3p1
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
